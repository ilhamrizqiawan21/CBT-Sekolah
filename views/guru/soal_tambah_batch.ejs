<%- include('../partials/header', { title: 'Tambah Soal Batch' }) %>
<%- include('../partials/sidebar_guru') %>

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="bi bi-table"></i> Tambah Soal (Format Excel)</h1>
        <a href="/guru/kelola-soal" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Kembali</a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header bg-success text-white">
            <h6 class="m-0 font-weight-bold">Pilih Ujian</h6>
        </div>
        <div class="card-body">
            <select id="pilihUjian" class="form-select w-50">
                <option value="">-- Pilih Ujian --</option>
                <% ujianList.forEach(u => { %>
                    <option value="<%= u.id %>"><%= u.nama_ujian %> - <%= u.nama_mapel %> (Kelas <%= u.nama_kelas %>)</option>
                <% }) %>
            </select>
            <button id="btnLoadForm" class="btn btn-success mt-3" disabled>Load Form Soal</button>
        </div>
    </div>

    <div id="formContainer" style="display:none;">
        <!-- Sama persis dengan form batch di admin, tapi ujian_id diambil dari dropdown -->
        <div id="sectionPG" class="card shadow mb-4">
            <div class="card-header bg-success text-white d-flex justify-content-between">
                <span>A. Soal Pilihan Ganda</span>
                <button type="button" class="btn btn-sm btn-light" id="tambahBarisPG">+ Tambah Baris</button>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead><tr><th>No</th><th>Teks Soal</th><th>Pilihan A</th><th>Pilihan B</th><th>Pilihan C</th><th>Pilihan D</th><th>Jawaban</th><th>Poin</th><th>Aksi</th></tr></thead>
                        <tbody id="tbodyPG"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div id="sectionMenjodohkan" class="card shadow mb-4">
            <div class="card-header bg-info text-white d-flex justify-content-between">
                <span>B. Soal Menjodohkan</span>
                <button type="button" class="btn btn-sm btn-light" id="tambahBarisMenjodohkan">+ Tambah Baris</button>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead><tr><th>No</th><th>Teks Soal</th><th>Pasangan Kiri</th><th>Pasangan Kanan</th><th>Poin</th><th>Aksi</th></tr></thead>
                        <tbody id="tbodyMenjodohkan"></tbody>
                    </table>
                </div>
                <div class="mt-3"><label>Pengecoh (pisahkan koma)</label><input type="text" id="pengecoh" class="form-control" placeholder="Contoh: Bandung, Surabaya"></div>
            </div>
        </div>

        <div id="sectionEssay" class="card shadow mb-4">
            <div class="card-header bg-warning text-dark d-flex justify-content-between">
                <span>C. Soal Essay</span>
                <button type="button" class="btn btn-sm btn-light" id="tambahBarisEssay">+ Tambah Baris</button>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead><tr><th>No</th><th>Teks Soal</th><th>Kata Kunci</th><th>Poin</th><th>Aksi</th></tr></thead>
                        <tbody id="tbodyEssay"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="text-center mb-5">
            <button id="btnSubmit" class="btn btn-primary btn-lg px-5">Simpan Semua Soal</button>
        </div>
    </div>
</div>

<script>
    let currentUjianId = null;
    let pgCount = 0, menCount = 0, essayCount = 0;

    document.getElementById('pilihUjian').addEventListener('change', function() {
        currentUjianId = this.value;
        document.getElementById('btnLoadForm').disabled = !currentUjianId;
    });

    document.getElementById('btnLoadForm').addEventListener('click', function() {
        if (!currentUjianId) return;
        document.getElementById('formContainer').style.display = 'block';
        ['PG', 'Menjodohkan', 'Essay'].forEach(s => {
            document.getElementById(`tbody${s}`).innerHTML = '';
        });
        pgCount = menCount = essayCount = 0;
        for (let i = 0; i < 5; i++) tambahBarisPG();
        for (let i = 0; i < 3; i++) tambahBarisMenjodohkan();
        for (let i = 0; i < 3; i++) tambahBarisEssay();
    });

    function tambahBarisPG() { pgCount++; addRow('PG', pgCount, ['teks_soal_pg', 'pilihan_a', 'pilihan_b', 'pilihan_c', 'pilihan_d', 'jawaban_pg', 'poin_pg']); }
    function tambahBarisMenjodohkan() { menCount++; addRow('Menjodohkan', menCount, ['teks_soal_men', 'kiri', 'kanan', 'poin_men']); }
    function tambahBarisEssay() { essayCount++; addRow('Essay', essayCount, ['teks_soal_essay', 'kata_kunci', 'poin_essay']); }

    function addRow(section, no, fields) {
        const tbody = document.getElementById(`tbody${section}`);
        const tr = document.createElement('tr');
        tr.innerHTML = `<td class="text-center">${no}</td>`;
        if (section === 'PG') {
            tr.innerHTML += `<td><textarea class="form-control teks_soal_pg" rows="2"></textarea></td>
                <td><input class="form-control pilihan_a"></td><td><input class="form-control pilihan_b"></td>
                <td><input class="form-control pilihan_c"></td><td><input class="form-control pilihan_d"></td>
                <td><select class="form-select jawaban_pg"><option value="">--</option><option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option></select></td>
                <td><input class="form-control poin_pg" value="1" style="width:70px"></td>`;
        } else if (section === 'Menjodohkan') {
            tr.innerHTML += `<td><textarea class="form-control teks_soal_men" rows="2"></textarea></td>
                <td><input class="form-control kiri" placeholder="Contoh: Pancasila ke-1"></td>
                <td><input class="form-control kanan" placeholder="Contoh: Ketuhanan"></td>
                <td><input class="form-control poin_men" value="2" style="width:70px"></td>`;
        } else {
            tr.innerHTML += `<td><textarea class="form-control teks_soal_essay" rows="2"></textarea></td>
                <td><input class="form-control kata_kunci" placeholder="kata1, kata2, kata3"></td>
                <td><input class="form-control poin_essay" value="3" style="width:70px"></td>`;
        }
        tr.innerHTML += `<td class="text-center"><button class="btn btn-sm btn-danger hapusBaris"><i class="bi bi-trash"></i></button></td>`;
        tbody.appendChild(tr);
        tr.querySelector('.hapusBaris').addEventListener('click', () => tr.remove());
    }

    document.getElementById('tambahBarisPG').addEventListener('click', tambahBarisPG);
    document.getElementById('tambahBarisMenjodohkan').addEventListener('click', tambahBarisMenjodohkan);
    document.getElementById('tambahBarisEssay').addEventListener('click', tambahBarisEssay);

    document.getElementById('btnSubmit').addEventListener('click', async () => {
        const soalPG = [], soalMen = [], soalEssay = [];
        document.querySelectorAll('#tbodyPG tr').forEach(tr => {
            const teks = tr.querySelector('.teks_soal_pg')?.value;
            if (!teks) return;
            soalPG.push({
                teks_soal: teks,
                pilihan_a: tr.querySelector('.pilihan_a')?.value || '',
                pilihan_b: tr.querySelector('.pilihan_b')?.value || '',
                pilihan_c: tr.querySelector('.pilihan_c')?.value || '',
                pilihan_d: tr.querySelector('.pilihan_d')?.value || '',
                jawaban_benar: tr.querySelector('.jawaban_pg')?.value || '',
                poin: parseInt(tr.querySelector('.poin_pg')?.value) || 1
            });
        });
        document.querySelectorAll('#tbodyMenjodohkan tr').forEach(tr => {
            const teks = tr.querySelector('.teks_soal_men')?.value;
            const kiri = tr.querySelector('.kiri')?.value;
            const kanan = tr.querySelector('.kanan')?.value;
            if (!teks || !kiri || !kanan) return;
            soalMen.push({ teks_soal: teks, pasangan: { kiri, kanan }, poin: parseInt(tr.querySelector('.poin_men')?.value) || 2 });
        });
        document.querySelectorAll('#tbodyEssay tr').forEach(tr => {
            const teks = tr.querySelector('.teks_soal_essay')?.value;
            if (!teks) return;
            soalEssay.push({
                teks_soal: teks,
                kata_kunci: tr.querySelector('.kata_kunci')?.value.split(',').map(k => k.trim()) || [],
                poin: parseInt(tr.querySelector('.poin_essay')?.value) || 3
            });
        });
        const pengecoh = document.getElementById('pengecoh')?.value.split(',').map(p => p.trim()).filter(p => p);
        const res = await fetch('/guru/soal/batch-tambah', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ujian_id: currentUjianId, soal_pg: soalPG, soal_menjodohkan: soalMen, soal_essay: soalEssay, pengecoh })
        });
        const result = await res.json();
        alert(result.success ? `Berhasil menyimpan ${result.total} soal!` : 'Gagal: ' + result.error);
        if (result.success) window.location.href = '/guru/kelola-soal';
    });
</script>

<%- include('../partials/footer') %>