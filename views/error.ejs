<!DOCTYPE html>
<html>
<head><title>Error</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"></head>
<body class="bg-light">
<div class="container mt-5">
    <div class="alert alert-danger">
        <h4>Terjadi Kesalahan</h4>
        <p><%= message %></p>
        <% if (error && error.stack) { %>
            <pre class="small"><%= error.stack %></pre>
        <% } %>
        <a href="/login" class="btn btn-primary">Kembali ke Login</a>
    </div>
</div>
</body>
</html>