<%- include('../partials/header', { title: 'Dashboard Admin' }) %>
<%- include('../partials/sidebar_admin') %>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-0 text-gray-800">Dashboard</h1>
            <p class="text-muted">Selamat datang, Administrator</p>
        </div>
    </div>

    <!-- Statistik Cards -->
    <div class="row">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Guru</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800"><%= totalGuru %></div>
                        </div>
                        <div class="col-auto"><i class="bi bi-people fs-1 text-gray-300"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Total Siswa</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800"><%= totalSiswa %></div>
                        </div>
                        <div class="col-auto"><i class="bi bi-person-badge fs-1 text-gray-300"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Total Ujian</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800"><%= totalUjian %></div>
                        </div>
                        <div class="col-auto"><i class="bi bi-calendar-check fs-1 text-gray-300"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Total Soal</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800"><%= totalSoal %></div>
                        </div>
                        <div class="col-auto"><i class="bi bi-question-circle fs-1 text-gray-300"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Grafik Analitik -->
    <div class="row">
        <div class="col-lg-7 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-primary text-white">Tren Rata-Rata Nilai (10 Ujian Terakhir)</div>
                <div class="card-body">
                    <% if (trenNilai.length === 0) { %>
                        <p class="text-muted text-center mb-0">Belum ada data nilai untuk ditampilkan</p>
                    <% } else { %>
                        <canvas id="chartTrenNilai" height="110"></canvas>
                    <% } %>
                </div>
            </div>
        </div>
        <div class="col-lg-5 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-success text-white">Rata-Rata Nilai per Kelas</div>
                <div class="card-body">
                    <% if (rataPerKelas.length === 0) { %>
                        <p class="text-muted text-center mb-0">Belum ada data nilai untuk ditampilkan</p>
                    <% } else { %>
                        <canvas id="chartRataKelas" height="110"></canvas>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Ujian Aktif & Siswa Per Kelas -->
    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">Ujian Aktif</div>
                <div class="card-body">
                    <div class="h2"><%= ujianAktif %></div>
                    <p class="text-muted">Ujian yang sedang berlangsung</p>
                    <a href="/admin/ujian" class="btn btn-sm btn-primary">Lihat Semua Ujian</a>
                </div>
            </div>
        </div>
        <div class="col-lg-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-success text-white">Distribusi Siswa per Kelas</div>
                <div class="card-body">
                    <ul class="list-group">
                        <% siswaPerKelas.forEach(k => { %>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <%= k.kelas || 'Tidak ada kelas' %>
                                <span class="badge bg-primary rounded-pill"><%= k.jumlah %></span>
                            </li>
                        <% }) %>
                        <% if (siswaPerKelas.length === 0) { %>
                            <li class="list-group-item">Belum ada data siswa</li>
                        <% } %>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Ujian Terbaru -->
    <div class="row">
        <div class="col-12 mb-4">
            <div class="card shadow">
                <div class="card-header bg-info text-white">Ujian Terbaru</div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead>
                                <tr><th>Nama Ujian</th><th>Mata Pelajaran</th><th>Kelas</th><th>Tanggal Mulai</th><th>Tanggal Selesai</th></tr>
                            </thead>
                            <tbody>
                                <% ujianTerbaru.forEach(u => { %>
                                <tr>
                                    <td><%= u.nama_ujian %></td>
                                    <td><%= u.nama_mapel %></td>
                                    <td><%= u.nama_kelas %></td>
                                    <td><%= new Date(u.tanggal_mulai).toLocaleString() %></td>
                                    <td><%= new Date(u.tanggal_selesai).toLocaleString() %></td>
                                </tr>
                                <% }) %>
                                <% if (ujianTerbaru.length === 0) { %>
                                <tr><td colspan="5" class="text-center">Belum ada ujian</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/vendor/chart.js/chart.umd.min.js"></script>
<script>
    (function() {
        // JSON.stringify tidak meng-escape "</script>"; data nama ujian/kelas bisa
        // diisi admin bebas, jadi harus dijaga agar tidak memutus tag <script> ini.
        const trenNilai = <%- JSON.stringify(trenNilai).replace(/</g, '\\u003c') %>;
        if (trenNilai.length > 0) {
            new Chart(document.getElementById('chartTrenNilai'), {
                type: 'line',
                data: {
                    labels: trenNilai.map(t => t.nama_ujian),
                    datasets: [{
                        label: 'Rata-rata Nilai',
                        data: trenNilai.map(t => Math.round(t.rata_rata * 10) / 10),
                        borderColor: '#4e73df',
                        backgroundColor: 'rgba(78, 115, 223, 0.1)',
                        tension: 0.3,
                        fill: true
                    }]
                },
                options: {
                    scales: { y: { beginAtZero: true, max: 100 } },
                    plugins: { legend: { display: false } }
                }
            });
        }

        const rataPerKelas = <%- JSON.stringify(rataPerKelas).replace(/</g, '\\u003c') %>;
        if (rataPerKelas.length > 0) {
            new Chart(document.getElementById('chartRataKelas'), {
                type: 'bar',
                data: {
                    labels: rataPerKelas.map(k => k.kelas || 'Tidak ada kelas'),
                    datasets: [{
                        label: 'Rata-rata Nilai',
                        data: rataPerKelas.map(k => Math.round(k.rata_rata * 10) / 10),
                        backgroundColor: '#1cc88a'
                    }]
                },
                options: {
                    scales: { y: { beginAtZero: true, max: 100 } },
                    plugins: { legend: { display: false } }
                }
            });
        }
    })();
</script>

<%- include('../partials/footer') %>