<%- include('../partials/header', { title: 'Tambah Soal Batch' }) %>
<%- include('../partials/sidebar_admin') %>

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="bi bi-table"></i> Tambah Soal (Format Excel)</h1>
        <a href="/admin/soal" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Kembali</a>
    </div>

    <!-- Pilih Mata Pelajaran & Ujian -->
    <div class="card shadow mb-4">
        <div class="card-header bg-primary text-white">
            <h6 class="m-0 font-weight-bold">1. Pilih Mata Pelajaran & Ujian</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-5 mb-3">
                    <label>Mata Pelajaran <span class="text-danger">*</span></label>
                    <select id="pilihMapel" class="form-select" required>
                        <option value="">-- Pilih Mata Pelajaran --</option>
                        <% mapelList.forEach(m => { %>
                            <option value="<%= m.id %>"><%= m.nama_mapel %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-5 mb-3">
                    <label>Ujian <span class="text-danger">*</span></label>
                    <select id="pilihUjian" class="form-select" disabled>
                        <option value="">-- Pilih Ujian --</option>
                    </select>
                </div>
                <div class="col-md-2 mb-3 d-flex align-items-end">
                    <button id="btnLoadSoal" class="btn btn-primary w-100" disabled>Load Soal</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabel Pilihan Ganda -->
    <div id="sectionPG" style="display:none;">
        <div class="card shadow mb-4">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold"><i class="bi bi-check-circle"></i> A. Soal Pilihan Ganda</h6>
                <button type="button" class="btn btn-sm btn-light" id="tambahBarisPG"><i class="bi bi-plus-lg"></i> Tambah Baris</button>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered" id="tabelPG">
                        <thead class="table-light">
                            <tr>
                                <th style="width:5%">No</th><th style="width:30%">Teks Soal</th>
                                <th style="width:12%">Pilihan A</th><th style="width:12%">Pilihan B</th>
                                <th style="width:12%">Pilihan C</th><th style="width:12%">Pilihan D</th>
                                <th style="width:7%">Jawaban</th><th style="width:5%">Poin</th><th style="width:5%">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyPG">
                            <!-- Baris dinamis akan ditambah di sini -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabel Menjodohkan -->
    <div id="sectionMenjodohkan" style="display:none;">
        <div class="card shadow mb-4">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold"><i class="bi bi-arrow-left-right"></i> B. Soal Menjodohkan</h6>
                <button type="button" class="btn btn-sm btn-light" id="tambahBarisMenjodohkan"><i class="bi bi-plus-lg"></i> Tambah Baris</button>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered" id="tabelMenjodohkan">
                        <thead class="table-light">
                            <tr>
                                <th style="width:5%">No</th><th style="width:35%">Teks Soal</th>
                                <th style="width:25%">Pasangan Kiri</th><th style="width:25%">Pasangan Kanan (Jawaban)</th>
                                <th style="width:5%">Poin</th><th style="width:5%">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyMenjodohkan">
                        </tbody>
                    </table>
                </div>
                <div class="mt-3">
                    <label>Pengecoh (opsional, pisahkan dengan koma)</label>
                    <input type="text" id="pengecoh" class="form-control" placeholder="Contoh: Bandung, Surabaya, Medan">
                    <small class="text-muted">Pengecoh akan ditampilkan sebagai pilihan tambahan untuk menjodohkan.</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabel Essay -->
    <div id="sectionEssay" style="display:none;">
        <div class="card shadow mb-4">
            <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold"><i class="bi bi-pencil"></i> C. Soal Essay</h6>
                <button type="button" class="btn btn-sm btn-light" id="tambahBarisEssay"><i class="bi bi-plus-lg"></i> Tambah Baris</button>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered" id="tabelEssay">
                        <thead class="table-light">
                            <tr>
                                <th style="width:5%">No</th><th style="width:60%">Teks Soal</th>
                                <th style="width:25%">Kata Kunci (pisahkan koma)</th>
                                <th style="width:5%">Poin</th><th style="width:5%">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyEssay">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Tombol Submit -->
    <div class="text-center mb-5">
        <button id="btnSubmitAll" class="btn btn-primary btn-lg px-5" disabled><i class="bi bi-save"></i> Simpan Semua Soal</button>
    </div>
</div>

<script>
    let currentUjianId = null;
    let pgRowCount = 0;
    let menjodohkanRowCount = 0;
    let essayRowCount = 0;

    // Load ujian berdasarkan mapel
    document.getElementById('pilihMapel').addEventListener('change', async function() {
        const mapelId = this.value;
        const ujianSelect = document.getElementById('pilihUjian');
        const btnLoad = document.getElementById('btnLoadSoal');
        if (!mapelId) {
            ujianSelect.innerHTML = '<option value="">-- Pilih Ujian --</option>';
            ujianSelect.disabled = true;
            btnLoad.disabled = true;
            return;
        }
        const res = await fetch(`/admin/api/ujian-by-mapel/${mapelId}`);
        const ujian = await res.json();
        ujianSelect.innerHTML = '<option value="">-- Pilih Ujian --</option>';
        ujian.forEach(u => {
            ujianSelect.innerHTML += `<option value="${u.id}">${u.nama_ujian}</option>`;
        });
        ujianSelect.disabled = false;
    });

    // Enable load button saat ujian dipilih
    document.getElementById('pilihUjian').addEventListener('change', function() {
        const btnLoad = document.getElementById('btnLoadSoal');
        btnLoad.disabled = !this.value;
        currentUjianId = this.value;
    });

    // Load / Reset form saat tombol Load diklik
    document.getElementById('btnLoadSoal').addEventListener('click', function() {
        if (!currentUjianId) return;
        // Reset semua tabel
        pgRowCount = 0;
        menjodohkanRowCount = 0;
        essayRowCount = 0;
        document.getElementById('tbodyPG').innerHTML = '';
        document.getElementById('tbodyMenjodohkan').innerHTML = '';
        document.getElementById('tbodyEssay').innerHTML = '';
        document.getElementById('pengecoh').value = '';
        // Tampilkan semua section
        document.getElementById('sectionPG').style.display = 'block';
        document.getElementById('sectionMenjodohkan').style.display = 'block';
        document.getElementById('sectionEssay').style.display = 'block';
        document.getElementById('btnSubmitAll').disabled = false;
        // Tambah 5 baris default untuk setiap tabel
        for (let i = 0; i < 5; i++) tambahBarisPG();
        for (let i = 0; i < 3; i++) tambahBarisMenjodohkan();
        for (let i = 0; i < 3; i++) tambahBarisEssay();
    });

    // Fungsi tambah baris PG
    function tambahBarisPG() {
        pgRowCount++;
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td class="text-center">${pgRowCount}</td>
            <td><textarea class="form-control teks_soal_pg" rows="2" placeholder="Teks soal..."></textarea></td>
            <td><input type="text" class="form-control pilihan_a" placeholder="Pilihan A"></td>
            <td><input type="text" class="form-control pilihan_b" placeholder="Pilihan B"></td>
            <td><input type="text" class="form-control pilihan_c" placeholder="Pilihan C"></td>
            <td><input type="text" class="form-control pilihan_d" placeholder="Pilihan D"></td>
            <td><select class="form-select jawaban_pg"><option value="">--</option><option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option></select></td>
            <td><input type="number" class="form-control poin_pg" value="1" style="width:70px"></td>
            <td class="text-center"><button class="btn btn-sm btn-danger hapusBaris"><i class="bi bi-trash"></i></button></td>
        `;
        document.getElementById('tbodyPG').appendChild(tr);
        tr.querySelector('.hapusBaris').addEventListener('click', () => tr.remove());
    }

    // Fungsi tambah baris Menjodohkan
    function tambahBarisMenjodohkan() {
        menjodohkanRowCount++;
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td class="text-center">${menjodohkanRowCount}</td>
            <td><textarea class="form-control teks_soal_menjodohkan" rows="2" placeholder="Teks soal..."></textarea></td>
            <td><input type="text" class="form-control pasangan_kiri" placeholder="Contoh: Pancasila ke-1"></td>
            <td><input type="text" class="form-control pasangan_kanan" placeholder="Contoh: Ketuhanan"></td>
            <td><input type="number" class="form-control poin_menjodohkan" value="2" style="width:70px"></td>
            <td class="text-center"><button class="btn btn-sm btn-danger hapusBaris"><i class="bi bi-trash"></i></button></td>
        `;
        document.getElementById('tbodyMenjodohkan').appendChild(tr);
        tr.querySelector('.hapusBaris').addEventListener('click', () => tr.remove());
    }

    // Fungsi tambah baris Essay
    function tambahBarisEssay() {
        essayRowCount++;
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td class="text-center">${essayRowCount}</td>
            <td><textarea class="form-control teks_soal_essay" rows="2" placeholder="Teks soal..."></textarea></td>
            <td><input type="text" class="form-control kata_kunci" placeholder="kata1, kata2, kata3"></td>
            <td><input type="number" class="form-control poin_essay" value="3" style="width:70px"></td>
            <td class="text-center"><button class="btn btn-sm btn-danger hapusBaris"><i class="bi bi-trash"></i></button></td>
        `;
        document.getElementById('tbodyEssay').appendChild(tr);
        tr.querySelector('.hapusBaris').addEventListener('click', () => tr.remove());
    }

    // Event tombol tambah baris
    document.getElementById('tambahBarisPG').addEventListener('click', tambahBarisPG);
    document.getElementById('tambahBarisMenjodohkan').addEventListener('click', tambahBarisMenjodohkan);
    document.getElementById('tambahBarisEssay').addEventListener('click', tambahBarisEssay);

    // Submit semua soal
    document.getElementById('btnSubmitAll').addEventListener('click', async function() {
        const soalPG = [];
        const soalMenjodohkan = [];
        const soalEssay = [];

        // Kumpulkan soal PG
        document.querySelectorAll('#tbodyPG tr').forEach(tr => {
            const teks = tr.querySelector('.teks_soal_pg')?.value;
            if (!teks) return;
            soalPG.push({
                teks_soal: teks,
                pilihan_a: tr.querySelector('.pilihan_a')?.value || '',
                pilihan_b: tr.querySelector('.pilihan_b')?.value || '',
                pilihan_c: tr.querySelector('.pilihan_c')?.value || '',
                pilihan_d: tr.querySelector('.pilihan_d')?.value || '',
                jawaban_benar: tr.querySelector('.jawaban_pg')?.value || '',
                poin: parseInt(tr.querySelector('.poin_pg')?.value) || 1
            });
        });

        // Kumpulkan soal Menjodohkan
        const pasanganList = [];
        document.querySelectorAll('#tbodyMenjodohkan tr').forEach(tr => {
            const teks = tr.querySelector('.teks_soal_menjodohkan')?.value;
            const kiri = tr.querySelector('.pasangan_kiri')?.value;
            const kanan = tr.querySelector('.pasangan_kanan')?.value;
            if (!teks || !kiri || !kanan) return;
            pasanganList.push({ kiri, kanan });
            soalMenjodohkan.push({
                teks_soal: teks,
                pasangan: { kiri, kanan },
                poin: parseInt(tr.querySelector('.poin_menjodohkan')?.value) || 2
            });
        });
        const pengecoh = document.getElementById('pengecoh')?.value.split(',').map(p => p.trim()).filter(p => p);

        // Kumpulkan soal Essay
        document.querySelectorAll('#tbodyEssay tr').forEach(tr => {
            const teks = tr.querySelector('.teks_soal_essay')?.value;
            const kataKunci = tr.querySelector('.kata_kunci')?.value;
            if (!teks) return;
            soalEssay.push({
                teks_soal: teks,
                kata_kunci: kataKunci.split(',').map(k => k.trim()),
                poin: parseInt(tr.querySelector('.poin_essay')?.value) || 3
            });
        });

        // Kirim ke server
        const response = await fetch('/admin/soal/batch-tambah', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                ujian_id: currentUjianId,
                soal_pg: soalPG,
                soal_menjodohkan: soalMenjodohkan,
                soal_essay: soalEssay,
                pengecoh: pengecoh
            })
        });
        const result = await response.json();
        if (result.success) {
            alert(`Berhasil menyimpan ${result.total} soal!`);
            window.location.href = '/admin/soal';
        } else {
            alert('Gagal menyimpan: ' + result.error);
        }
    });
</script>

<%- include('../partials/footer') %>