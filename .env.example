PORT=3000
DB_HOST=127.0.0.1
# Opsional: UNIX socket untuk koneksi lokal (Fedora: /var/lib/mysql/mysql.sock, Ubuntu: /var/run/mysqld/mysqld.sock)
# DB_SOCKET=/var/lib/mysql/mysql.sock
DB_USER=root
DB_PASSWORD=
DB_NAME=cbt_sekolah
SESSION_SECRET=ganti-dengan-secret-yang-kuat
NODE_ENV=development
TAMPILKAN_NILAI_SISWA=false
# Wajib diisi. Pada NODE_ENV=production minimal 32 karakter acak (mis. `openssl rand -hex 32`)
# Cookie sesi 'Secure' (butuh HTTPS). Default: aktif bila NODE_ENV=production.
# Jika server diakses lewat http://IP-SERVER:3000 di jaringan lokal TANPA HTTPS, set false
# (kalau tidak, peramban menolak cookie dan siapa pun tidak bisa login).
# COOKIE_SECURE=false
# Toleransi detik setelah batas waktu ujian untuk jawaban yang tertunda (default 120)
# GRACE_PERIOD_DETIK=120
