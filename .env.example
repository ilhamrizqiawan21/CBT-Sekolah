PORT=3000
DB_HOST=127.0.0.1
# Opsional: UNIX socket untuk koneksi lokal (Fedora: /var/lib/mysql/mysql.sock, Ubuntu: /var/run/mysqld/mysqld.sock)
# DB_SOCKET=/var/lib/mysql/mysql.sock
DB_USER=root
DB_PASSWORD=
DB_NAME=cbt_sekolah
# Produksi: minimal 32 karakter acak, mis. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=ganti-dengan-secret-yang-kuat
NODE_ENV=development
# Cookie sesi hanya dikirim lewat HTTPS. Default: aktif bila NODE_ENV=production.
# Isi false bila server diakses lewat http://<IP>:3000 di LAN sekolah tanpa HTTPS,
# jika tidak, tidak ada yang bisa login.
# COOKIE_SECURE=false
TAMPILKAN_NILAI_SISWA=false
